# Server
PORT=3000
CLIENT_URL=http://localhost:5173
# Use an absolute SQLite file URL for local Prisma on macOS.
# Example: file:/Users/you/nero-party/apps/server/prisma/dev.db
DATABASE_URL=file:/absolute/path/to/nero-party/apps/server/prisma/dev.db
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
VITE_PUBLIC_API_URL=http://localhost:3000

# Audius
AUDIUS_API_BASE=https://api.audius.co/v1

# Spotify host queue demo
# Add this exact redirect URI in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_SCOPES=user-modify-playback-state user-read-playback-state user-read-currently-playing

# Discord private beta
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_BOT_SECRET=
NERO_API_URL=http://localhost:3000
NERO_WEB_URL=http://localhost:5173

# Desktop private beta signing and updates are configured by CI/release secrets.
