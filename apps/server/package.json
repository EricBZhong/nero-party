{
  "name": "@nero/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('server smoke: no standalone tests configured')\"",
    "start": "node dist/index.js",
    "prisma:generate": "node scripts/with-root-env.mjs prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "node scripts/with-root-env.mjs prisma migrate dev --schema prisma/schema.prisma",
    "prisma:push": "node scripts/with-root-env.mjs node scripts/prepare-sqlite.mjs && node scripts/with-root-env.mjs prisma db push --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nero/player": "0.1.0",
    "@nero/shared": "0.1.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.1.1",
    "nanoid": "^5.0.9",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^22.9.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
